            }
        },
        {
            "label": "cicsdev: update-zowe-profile",
            "type": "shell",
            "command": "just",
            "args": [
                "update-zowe-profile"
            ],
            "problemMatcher": []
        },
        {
            "label": "cicsdev: create-jvmserver",
            "type": "shell",
            "command": "just",
            "args": [
                "create-jvmserver"
            ],
            "problemMatcher": []
        },
        {
            "label": "cicsdev: define-bundle",
            "type": "shell",
            "command": "just",
            "args": [
                "define-bundle"
            ],
            "problemMatcher": []
        },
        {
            "label": "cicsdev: deploy-bundle",
            "type": "shell",
            "command": "just",
            "args": [
