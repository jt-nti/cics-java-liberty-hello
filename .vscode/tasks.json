    "version": "2.0.0",
    "tasks": [
        {
            "label": "cicsdev: build",
            "type": "shell",
            "command": "just",
            "args": [
                "build"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "cicsdev: build-resources",
            "type": "shell",
            "command": "just",
            "args": [
                "build-resources"
            ],
